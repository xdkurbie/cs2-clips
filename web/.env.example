# Copy to web/.env. Never commit real values.

# Owner's Steam Web API key (https://steamcommunity.com/dev/apikey).
# Used only to walk GetNextMatchSharingCode. Not a user auth code.
STEAM_WEB_API_KEY=

# Dedicated bot account for the CS2 Game Coordinator (demo URLs).
# Prefer a refresh token from `npm run bot-login` over a stored password.
STEAM_BOT_REFRESH_TOKEN=
STEAM_BOT_USERNAME=
STEAM_BOT_PASSWORD=
# Optional base64 shared secret from the bot's own Steam Guard setup.
STEAM_BOT_SHARED_SECRET=

# Where parsed matches are stored. On Render, mount a disk here.
DATA_DIR=./data
PORT=8787
HOST=0.0.0.0

# If the frontend is hosted on another origin (Vercel), set it here.
# User auth codes are never written to disk; they stay in the browser tab.
CORS_ORIGIN=

# python3 and the parser path, if they are not on PATH / in this repo.
# PYTHON=python3
# PARSER=
# FRONTEND_DIST=
