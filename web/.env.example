# Copy to web/.env. Never commit real values.

# Owner's Steam Web API key (https://steamcommunity.com/dev/apikey).
# Used for GetNextMatchSharingCode and GetPlayerSummaries. Not a user auth code.
STEAM_WEB_API_KEY=

# Dedicated bot account. Prefer a refresh token from `npm run bot-login`.
# The bot stays online, accepts friend requests, and downloads demos.
# A limited Steam account can accept friend requests but cannot send them.
STEAM_BOT_REFRESH_TOKEN=
STEAM_BOT_USERNAME=
STEAM_BOT_PASSWORD=
# Optional base64 shared secret from the bot's own Steam Guard setup.
STEAM_BOT_SHARED_SECRET=
# Optional. Otherwise derived from the bot SteamID after login.
STEAM_BOT_PROFILE_URL=

# Signs the httpOnly session cookie (SameSite=None; Secure on https).
SESSION_SECRET=
# AES-256-GCM key for the user's match-history code and share code. Any long secret.
ENCRYPTION_KEY=

# Postgres connection string. Unset uses SQLite in DATA_DIR.
DATABASE_URL=
# DATABASE_SSL=disable

# Public origins. OpenID returns to PUBLIC_API_URL. Login sends the browser to FRONTEND_URL.
# Local OpenID return URL. Use the Vite origin so the session cookie is set on the same host the UI calls.
PUBLIC_API_URL=http://127.0.0.1:5173
FRONTEND_URL=http://127.0.0.1:5173/cs2-clips
CORS_ORIGIN=https://xdkurbie.github.io

# Where parsed matches are stored. Free Render uses /tmp/cs2clips (ephemeral, pruned).
DATA_DIR=./data
PORT=8787
HOST=0.0.0.0

# How often to look for new matches, in milliseconds.
# POLL_INTERVAL_MS=180000

# PYTHON=python3
# PARSER=
# FRONTEND_DIST=
